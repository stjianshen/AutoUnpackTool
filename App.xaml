<Application x:Class="AutoUnpackTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:AutoUnpackTool.Services">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 日志颜色：ConsoleColor -> 画刷 -->
            <services:ConsoleColorToBrushConverter x:Key="ConsoleColorToBrush"/>
            <!-- bool -> Visibility -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
