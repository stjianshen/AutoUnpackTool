<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>AutoUnpackTool</RootNamespace>
    <AssemblyName>AutoUnpackTool</AssemblyName>
    <ApplicationIcon />
    <StartupObject>AutoUnpackTool.App</StartupObject>
    <!-- 抑制 NU1510 警告，因为 System.Text.Encoding.CodePages 是必需的 -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 防止 SDK 默认 glob 把 Core 源码与历史备份目录二次纳入本项目编译 -->
    <Compile Remove="Core\**;.history\**" />
    <Page Remove="Core\**" />
    <None Remove="Core\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 代码页编码器支持（用于 GBK 等编码） -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.5" />
    <!-- MVVM：可观察属性 + RelayCommand -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- 依赖注入容器（阶段4 DI 启动） -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\AutoUnpackTool.Core.csproj" />
  </ItemGroup>

</Project>
